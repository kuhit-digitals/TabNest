
{
  "manifest_version": 3,
  "name": "TabNest",
  "version": "1.1.0",
  "description": "Save and restore browser workspaces using natural language and your preferred AI.",

  "action": {
    "default_popup": "popup.html"
  },

  "permissions": [
    "tabs",
    "storage"
  ],

  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ]
}
